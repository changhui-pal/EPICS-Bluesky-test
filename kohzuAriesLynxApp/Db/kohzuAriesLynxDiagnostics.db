# Read-only controller-level ARIES error and warning diagnostics.
# Waveforms avoid the 40-character limit of EPICS stringin records.
record(longin, "$(P)Diag:LastErrorCode") {
    field(DESC, "Last ARIES error code")
    field(DTYP, "asynInt32")
    field(INP,  "@asyn($(PORT),0)LAST_ERROR_CODE")
    field(SCAN, "I/O Intr")
}
record(waveform, "$(P)Diag:LastErrorText") {
    field(DESC, "Last ARIES error meaning")
    field(DTYP, "asynOctetRead")
    field(INP,  "@asyn($(PORT),0)LAST_ERROR_TEXT")
    field(FTVL, "CHAR")
    field(NELM, "256")
    field(SCAN, "I/O Intr")
}
record(waveform, "$(P)Diag:LastErrorCommand") {
    field(DESC, "Command reporting error")
    field(DTYP, "asynOctetRead")
    field(INP,  "@asyn($(PORT),0)LAST_ERROR_COMMAND")
    field(FTVL, "CHAR")
    field(NELM, "64")
    field(SCAN, "I/O Intr")
}
record(waveform, "$(P)Diag:LastErrorRaw") {
    field(DESC, "Raw ARIES error response")
    field(DTYP, "asynOctetRead")
    field(INP,  "@asyn($(PORT),0)LAST_ERROR_RAW")
    field(FTVL, "CHAR")
    field(NELM, "256")
    field(SCAN, "I/O Intr")
}
record(longin, "$(P)Diag:LastWarningCode") {
    field(DESC, "Last ARIES warning code")
    field(DTYP, "asynInt32")
    field(INP,  "@asyn($(PORT),0)LAST_WARNING_CODE")
