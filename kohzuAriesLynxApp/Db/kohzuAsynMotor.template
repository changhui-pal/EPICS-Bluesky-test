# Project-local asyn motor record template. It follows motor-R7-3-1's
# asyn_motor.db. The SDIS/_able lock below is DEVELOPMENT-ONLY and is not part
# of the final operating interface. After development, comment out SDIS and
# the _able record together, and stop loading the commissioning substitutions.

record(motor, "$(P)$(M)") {
    field(DESC, "$(DESC)")
    field(DTYP, "$(DTYP)")
    field(DIR,  "$(DIR)")
    field(VELO, "$(VELO)")
    field(VBAS, "$(VBAS)")
    field(ACCL, "$(ACCL)")
    field(ACCU, "$(ACCU=0)")
    field(BDST, "$(BDST)")
    field(BVEL, "$(BVEL)")
    field(BACC, "$(BACC)")
    field(OUT,  "@asyn($(PORT),$(ADDR))")
    field(MRES, "$(MRES)")
    field(PREC, "$(PREC)")
    field(EGU,  "$(EGU)")
    field(DHLM, "$(DHLM)")
    field(DLLM, "$(DLLM)")
    field(INIT, "$(INIT)")
    field(RTRY, "$(RTRY=10)")
    field(RSTM, "$(RSTM=NearZero)")
    field(TWV,  "1")
    field(SDIS, "$(P)$(M)_able.VAL")
}

# DEVELOPMENT-ONLY LOCK PV; unused in final operation after SDIS is removed.
record(bo, "$(P)$(M)_able") {
    field(DESC, "motor enable (internal)")
    field(ASG,  "KOHZU_INTERNAL_ENABLE")
    field(PINI, "YES")
    field(ZNAM, "Enable")
    field(ONAM, "Disable")
}

record(calcout, "$(P)$(M)_vCh") {
    field(DESC, "change velocity")
    field(CALC, "min(max(a*b,c),d)")
    field(INPB, "$(P)$(M).S")
    field(INPC, "$(P)$(M).SBAS")
    field(INPD, "$(P)$(M).SMAX")
    field(OUT,  "$(P)$(M).S")
}

record(calcout, "$(P)$(M)_twCh") {
    field(DESC, "change TWV")
    field(CALC, "min(max(a*b,c),d-e)")
    field(INPB, "$(P)$(M).TWV")
    field(INPC, "$(P)$(M).MRES")
    field(INPD, "$(P)$(M).HLM")
    field(INPE, "$(P)$(M).LLM")
    field(OUT,  "$(P)$(M).TWV")
}

# Publish motor record direction, offset and resolution to Model 3.
record(longout, "$(P)$(M)Direction") {
    field(DESC, "$(M) direction")
    field(DOL,  "$(P)$(M).DIR CP MS")
    field(OMSL, "closed_loop")
    field(DTYP, "asynInt32")
    field(OUT,  "@asyn($(PORT),$(ADDR))MOTOR_REC_DIRECTION")
}

record(ao, "$(P)$(M)Offset") {
    field(DESC, "$(M) offset")
    field(DOL,  "$(P)$(M).OFF CP MS")
    field(OMSL, "closed_loop")
    field(DTYP, "asynFloat64")
    field(OUT,  "@asyn($(PORT),$(ADDR))MOTOR_REC_OFFSET")
    field(PREC, "$(PREC)")
}

record(ao, "$(P)$(M)Resolution") {
    field(DESC, "$(M) resolution")
    field(DOL,  "$(P)$(M).MRES CP MS")
    field(OMSL, "closed_loop")
    field(DTYP, "asynFloat64")
    field(OUT,  "@asyn($(PORT),$(ADDR))MOTOR_REC_RESOLUTION")
    field(PREC, "$(PREC)")
}
